# Copy this file to .env and fill in real values.
# Never commit the real .env to git.

NODE_ENV=development
PORT=3000

# MongoDB connection string (Atlas, local, or Docker)
DB_CONNECTION=mongodb://localhost:27017/brainly

# Secret used to sign JWTs. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Frontend origin for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Logger verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info