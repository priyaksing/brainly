# Copy this file to .env and fill in real values.
# Never commit the real .env to git.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Use the SAME connection string as brainly-backend/.env so this script reads
# and writes the same bookmarks.
#
# IMPORTANT: the string must end with the database name, e.g.
#   mongodb+srv://user:pass@cluster.mongodb.net/brainly
# If the "/brainly" part is missing, the script cannot tell which database to
# open and will stop with an error explaining this.
DB_CONNECTION=

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
# A new account needs a small amount of credit added before the API will work.
OPENAI_API_KEY=

# Model used to write summaries and tags. gpt-4o-mini is cheap and more than
# good enough for summarising a webpage. OpenAI's model list changes often, so
# check https://platform.openai.com/docs/models if this name stops working.
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# How many bookmarks to enrich per run. Kept low on purpose so your first run
# is cheap and you can eyeball the results before doing the whole library.
# Raise it once you trust the output.
BATCH_LIMIT=10

# Characters of page text to send to the model. More text costs more and helps
# only up to a point - most articles say what they are about early on.
MAX_TEXT_CHARS=6000

# Seconds to wait for a page to respond before giving up.
REQUEST_TIMEOUT=15
